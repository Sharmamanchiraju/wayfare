# ----------------------------------------
# GENERAL CONFIGURATION
# ----------------------------------------
ENVIRONMENT=production

# ----------------------------------------
# DATABASE (PostgreSQL)
# ----------------------------------------
POSTGRES_USER=trip_user
POSTGRES_PASSWORD=secure_password123
POSTGRES_DB=trip_planner
# This is used by the backend inside the Docker network
DATABASE_URL=postgresql+asyncpg://trip_user:secure_password123@db:5432/trip_planner

# ----------------------------------------
# AUTHENTICATION
# ----------------------------------------
# Generate a secure key using: openssl rand -hex 32
JWT_SECRET=replace_this_with_a_highly_secure_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------
# LLM & AGENT APIS
# ----------------------------------------
GROQ_API_KEY=your_groq_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# ----------------------------------------
# FRONTEND CONFIGURATION
# ----------------------------------------
# Next.js accesses the backend API from the client's browser, 
# so this must be the publicly accessible URL of the backend.
NEXT_PUBLIC_API_URL=http://localhost:8000
